[Unit]
Description=Kokoro TTS Web Frontend
After=network.target kokoro.service

[Service]
User=__USER__
Group=__USER__
WorkingDirectory=__HOME__/tts-web
Environment="PATH=__HOME__/Kokoro-TTS-Airgapped-main/Kokoro-FastAPI-master/venv/bin"
ExecStart=__HOME__/Kokoro-TTS-Airgapped-main/Kokoro-FastAPI-master/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
